    "f = compute_system_force(X.clone(), edge_index, u) \n",
    "Strain_energy = 0.5 * f.reshape(1, -1) @ u.reshape(1, -1).T\n",
    "back_str = time.time()\n",
    "Strain_energy.backward()\n",
    "back_end = time.time() - back_str \n",
    "\n",
    "# print(\"FE_time\", cg_end)\n",
    "# print(\"Back Time\", back_end)\n",
    "print('u', u)\n",
    "print('f ',f )"
   ]
