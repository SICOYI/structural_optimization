    "def Symmetry_shaper(q, matrix):\n",
    "\n",
    "    rows, cols = matrix.shape\n",
    "\n",
    "    row_odd = rows % 2 == 1\n",
    "    col_odd = cols % 2 == 1\n",
    "    \n",
    "    if row_odd:\n",
    "\n",
    "        q = torch.cat([q, q.flip(0)[1:,:]], dim=0)\n",
    "    else:\n",
    "\n",
    "        q = torch.cat([q, q.flip(0)], dim=0)\n",
    "    \n",
    "\n",
    "    if col_odd:\n",
    "\n",
    "        q = torch.cat([q, q.flip(1)[:,1:]], dim=1)\n",
    "    else:\n",
    "\n",
    "        q = torch.cat([q, q.flip(1)], dim=1)\n",
    "    \n",
    "    return q\n",
    "    "
